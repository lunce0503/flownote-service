# cp .env.example .env  and fill in.  .env is gitignored.

# OPTIONAL. Gemma 4 is Apache-2.0 and NOT gated, so downloads work without a
# token - this only raises Hub rate limits (and is needed to push the adapter).
HF_TOKEN=

# Teacher model for synthetic data generation (src/flownote_agent/data/synth.py).
# Cost per accepted conversation: ~$0.053 on claude-opus-5, ~$0.032 on
# claude-sonnet-5, ~$0.011 on claude-haiku-4-5. Start with --n 100.
ANTHROPIC_API_KEY=

# On a RunPod pod, point every cache at the persistent volume (/workspace).
# Without this, a 5B model download is lost on every pod restart.
HF_HOME=/workspace/hf_cache

# Optional run tracking
WANDB_API_KEY=
WANDB_PROJECT=flownote-agent
