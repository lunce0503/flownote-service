<Window x:Class="Flownote.Remote.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Flownote Remote · 제스처 설정" AutomationProperties.AutomationId="GestureSettings" Width="620" Height="760" MinWidth="420" MinHeight="480"
 Background="#F6F3EB" Foreground="#202020" FontSize="15">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="28" MaxWidth="800">
   <TextBlock Text="제스처 세부 설정" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="신뢰도·유지·재실행 기준을 서버에 적용합니다. 범주별 명령은 대시보드 안내를 따릅니다."/>
   <TextBlock Text="기본 카메라 방향 (대시보드에서 선택 가능)"/>
   <ComboBox x:Name="Facing" AutomationProperties.Name="카메라 방향"/>
   <CheckBox x:Name="Enabled" Content="제스처 사용 설정 저장 (서버에서 명령 허용을 별도 확인)" Margin="0,10"/>
   <TextBlock x:Name="ConfidenceLabel"/>
   <Slider x:Name="Confidence" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="최소 인식 신뢰도"/>
   <TextBlock x:Name="HoldLabel"/>
   <Slider x:Name="Hold" Minimum="100" Maximum="2000" TickFrequency="100" IsSnapToTickEnabled="True" AutomationProperties.Name="유지 시간"/>
   <TextBlock x:Name="CooldownLabel"/>
   <Slider x:Name="Cooldown" Minimum="300" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" AutomationProperties.Name="재실행 간격"/>
   <TextBlock Text="이전 손 모양 진단용 매핑 · 실제 골격 명령에는 적용되지 않습니다." FontWeight="SemiBold" Margin="0,20,0,4"/>
   <StackPanel x:Name="BindingsPanel"/>
   <TextBlock x:Name="VolumeLabel"/>
   <Slider x:Name="Volume" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="음량 설정"/>
   <TextBlock Text="EQ 프리셋 (실제 출력 준비 중)"/>
   <ComboBox x:Name="Preset" AutomationProperties.Name="EQ 프리셋"/>
   <TextBlock Text="비서: 연결 준비 중 · 실행 전 확인 필수"/>
   <WrapPanel>
    <Button Content="설정 저장" Click="Save_Click"/>
    <Button Content="기본값 복원" Click="Reset_Click"/>
   </WrapPanel>
   <TextBlock Text="테스트 입력 · 현재 화면의 설정으로 동작 이름만 확인합니다." FontWeight="SemiBold"/>
   <ComboBox x:Name="TestGesture" AutomationProperties.Name="테스트할 제스처"/>
   <Button Content="제스처 유지 테스트" Click="Test_Click" HorizontalAlignment="Left"/>
   <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite"/>
   <Button x:Name="ShowLicenses" Content="오픈소스 라이선스" Click="Licenses_Click" HorizontalAlignment="Left"/>
  </StackPanel>
 </ScrollViewer>
</Window>
