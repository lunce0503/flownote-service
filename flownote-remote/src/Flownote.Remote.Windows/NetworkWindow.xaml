<Window x:Class="Flownote.Remote.Windows.NetworkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Flownote Remote · 서버와 클라이언트" AutomationProperties.AutomationId="NetworkPanel" Width="920" Height="860" MinWidth="440" MinHeight="520" Background="#F6F3EB" FontSize="15">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="서버 · 클라이언트 연결" FontSize="25" FontWeight="SemiBold"/>
  <TextBlock Text="신뢰하는 사설/VPN 네트워크에서 사용하세요. 포트 자동 개방은 하지 않습니다."/>
  <TextBlock Text="PC 서버: 제스처 판정·명령·상태 알림 / 클라이언트: 카메라·소리 출력·조작 화면"/>
  <TextBlock Text="서버 주소로 사용할 PC IPv4"/><ComboBox x:Name="BindAddress" AutomationProperties.Name="서버 IP"/>
  <WrapPanel><Button x:Name="StartServer" Content="서버 시작" Click="StartServer_Click"/><Button Content="서버 중지" Click="Stop_Click"/><Button Content="새 등록 코드" Click="Pair_Click"/></WrapPanel>
  <TextBlock x:Name="ServerDetails" Text="서버 꺼짐" TextWrapping="Wrap"/>
  <CheckBox x:Name="AllowGestures" Content="카메라 제스처 명령 허용 (기본 OFF)" Margin="0,8"/>
  <Button Content="현재 제스처 설정 적용" Click="Configure_Click" HorizontalAlignment="Left"/>
  <TextBlock Text="클라이언트 연결" FontWeight="SemiBold" FontSize="20"/>
  <TextBlock Text="서버 HTTPS 주소"/><TextBox x:Name="ServerUrl" AutomationProperties.Name="서버 HTTPS 주소" MinHeight="32"/>
  <TextBlock Text="서버 화면에 표시된 인증서 SHA-256 지문"/><TextBox x:Name="ServerPin" MinHeight="32"/>
  <TextBlock Text="기기 이름"/><TextBox x:Name="DeviceName" MinHeight="32"/>
  <TextBlock Text="일회용 등록 코드 (2분 유효)"/><PasswordBox x:Name="PairCode" MinHeight="32"/>
  <CheckBox x:Name="PinConfirmed" Content="서버 화면의 주소·지문과 직접 대조했습니다" Margin="0,8"/>
  <WrapPanel><Button Content="등록 / 연결" Click="Connect_Click"/><Button Content="연결 해제" Click="Disconnect_Click"/></WrapPanel>
  <TextBlock Text="제어 대상 기기"/><ComboBox x:Name="Target" DisplayMemberPath="Name" SelectedValuePath="Id"/>
  <TextBlock Text="음성 알림 출력 기기 (서버에서 선택)"/><ComboBox x:Name="VoiceTarget" DisplayMemberPath="Name" SelectedValuePath="Id"/>
  <Button Content="서버의 대상 선택 적용" Click="Targets_Click" HorizontalAlignment="Left"/>
  <WrapPanel><Button Content="음량 +" Tag="volume_up" Click="Command_Click"/><Button Content="음량 −" Tag="volume_down" Click="Command_Click"/><Button Content="음소거" Tag="mute" Click="Command_Click"/><Button Content="음소거 해제" Tag="unmute" Click="Command_Click"/></WrapPanel>
  <CheckBox x:Name="SpeakAlerts" Content="이 기기에서 비서 음성 알림 사용" IsChecked="True" Margin="0,8"/>
  <WrapPanel><Button Content="카메라 전송 시작" Click="Camera_Click"/><Button Content="카메라 전송 중지" Click="CameraStop_Click"/></WrapPanel>
  <ContentControl x:Name="CameraHost" Height="310"/>
  <TextBlock x:Name="Detection" Text="카메라 꺼짐"/>
  <TextBlock Text="등록 해제할 기기 (서버 관리자)"/><ComboBox x:Name="Registered" DisplayMemberPath="Name" SelectedValuePath="Id"/>
  <Button Content="선택 기기 등록 해제" Click="Revoke_Click" HorizontalAlignment="Left"/>
  <TextBlock Text="음원 전송·분리/합성·화면 배치·프로젝터 출력·대화형 AI는 아직 연결 전입니다."/>
  <TextBox x:Name="Events" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="150" AutomationProperties.Name="연결과 상태 알림"/>
 </StackPanel></ScrollViewer>
</Window>
