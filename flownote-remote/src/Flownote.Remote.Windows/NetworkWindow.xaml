<Window x:Class="Flownote.Remote.Windows.NetworkWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Flownote Remote" AutomationProperties.AutomationId="NetworkPanel" Width="1080" Height="880" MinWidth="400" MinHeight="540"
 Background="#F3F5F1" Foreground="#20352D" FontFamily="Segoe UI" FontSize="15">
 <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24" MaxWidth="1180">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Flownote Remote" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="연결된 기기로, 손쉽게 제어하세요." Foreground="#61736A"/></StackPanel>
    <Button x:Name="DashboardMore" Grid.Column="1" Content="⋯" FontSize="26" Padding="0" Margin="0" AutomationProperties.Name="더 보기" Click="More_Click">
     <Button.ContextMenu><ContextMenu>
      <MenuItem x:Name="OpenSettingsMenu" Header="제스처 세부 설정" Click="Settings_Click"/>
      <MenuItem Header="서버 연결 설정" Click="ServerOptions_Click"/>
      <MenuItem x:Name="OpenDetailsMenu" Header="연결 정보와 기록" Click="Details_Click"/>
      <MenuItem Header="서버에 연결 / 연결 해제" Click="ConnectionMenu_Click"/>
      <MenuItem Header="카메라로 연결 QR 읽기" Click="ScanQr_Click"/>
      <Separator/><MenuItem Header="서버 중지" Click="Stop_Click"/>
      <MenuItem Header="오픈소스 라이선스" Click="Licenses_Click"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
   </Grid>
   <Border Background="#E4ECE6" CornerRadius="12" Padding="14" Margin="0,14,0,18"><TextBlock x:Name="ConnectionStatus" Text="서버를 시작하거나 다른 PC에 연결하세요." AutomationProperties.LiveSetting="Polite"/></Border>
   <WrapPanel Margin="0,0,0,16">
    <Button x:Name="StartServer" Content="이 PC에서 서버 시작" Style="{StaticResource PrimaryAction}" Click="StartServer_Click"/>
    <Button x:Name="AddClient" Content="＋ 클라이언트 연결" Click="AddClient_Click"/>
    <Button x:Name="JoinServer" Content="서버에 연결" Click="Join_Click"/>
   </WrapPanel>
   <TextBlock Text="빠른 제어" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <UniformGrid x:Name="FeatureGrid" Columns="2">
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="♪  소리" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock x:Name="SoundSummary" Text="클라이언트를 연결해 주세요." Foreground="#61736A" MinHeight="42"/>
     <WrapPanel><Button Content="−" Tag="volume_down" AutomationProperties.Name="음량 줄이기" Click="Command_Click"/><Button Content="＋" Tag="volume_up" AutomationProperties.Name="음량 높이기" Click="Command_Click"/><Button x:Name="MuteControl" Content="음소거" Click="Mute_Click"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <Grid><TextBlock Text="◉  카메라" FontSize="21" FontWeight="SemiBold"/><ToggleButton x:Name="CameraControl" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="카메라 전송" Checked="CameraToggle_Click" Unchecked="CameraToggle_Click"/></Grid>
     <TextBlock x:Name="Detection" Text="카메라 꺼짐 · 골격만 전송합니다." Foreground="#61736A" MinHeight="42"/>
     <Button x:Name="ChooseCameraSource" Content="전면 / 후면 / 장치 선택" Click="CameraSource_Click"/>
     <Button Content="QR로 빠르게 연결" Click="ScanQr_Click"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <Grid><TextBlock Text="✋  제스처" FontSize="21" FontWeight="SemiBold"/><ToggleButton x:Name="AllowGestures" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="제스처 명령 허용" Checked="Gestures_Click" Unchecked="Gestures_Click"/></Grid>
     <TextBlock Text="전체 · 중간 관리 · 세밀 조정" Foreground="#61736A" MinHeight="42"/>
     <Button Content="범주별 제스처 안내" Click="GestureGuide_Click"/>
     <TextBlock x:Name="GestureSummary" Text="서버에서 켤 수 있어요."/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <Grid><TextBlock Text="◌  음성 알림" FontSize="21" FontWeight="SemiBold"/><ToggleButton x:Name="SpeakAlerts" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" AutomationProperties.Name="이 기기 음성 알림" Checked="Voice_Click" Unchecked="Voice_Click"/></Grid>
     <TextBlock Text="배터리·장치 오류·연결 끊김을 알려드려요." Foreground="#61736A" MinHeight="42"/>
     <TextBlock Text="음성이 어려울 때는 화면으로 안내합니다."/>
    </StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,16,0,10"><TextBlock x:Name="ClientsTitle" Text="클라이언트" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="사용 허용 · 연결된 기능" HorizontalAlignment="Right" Foreground="#61736A" VerticalAlignment="Bottom" FontSize="12"/></Grid>
   <TextBlock x:Name="EmptyClients" Text="아직 연결된 클라이언트가 없어요. 서버를 시작하고 ‘클라이언트 연결’에서 QR을 보여주세요." Foreground="#61736A" Margin="0,0,0,16"/>
   <ItemsControl x:Name="ClientList"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
     <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Tag="{Binding Id}" AutomationProperties.AutomationId="{Binding ToggleId}" AutomationProperties.Name="{Binding ToggleLabel}" Checked="ClientToggle_Click" Unchecked="ClientToggle_Click" ToolTip="{Binding ToggleHint}"/>
     <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Summary}" Foreground="#61736A" FontSize="13"/></StackPanel>
     <Button Grid.Column="2" Content="⋯" FontSize="24" Padding="0" Margin="0" Tag="{Binding Id}" AutomationProperties.Name="{Binding MenuLabel}" Click="ClientMore_Click"/>
    </Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="선택한 작업 인터페이스" FontSize="20" FontWeight="SemiBold"/>
    <ComboBox x:Name="TaskChoice" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="실행 중인 작업 선택" SelectionChanged="TaskChoice_Changed" MinHeight="40"/>
    <Grid x:Name="TaskViewport" Height="160" ClipToBounds="True" Margin="0,8">
     <Border x:Name="ControlledPane" Background="#E4ECE6" CornerRadius="12" Padding="16" RenderTransformOrigin=".5,.5"><StackPanel>
      <TextBlock x:Name="ActiveTaskName" Text="실행 중인 작업 없음" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="ActiveTaskDetails" Text="서버에 연결된 Codex 작업을 선택하면 확인할 수 있어요." Visibility="Collapsed" TextWrapping="Wrap"/>
     </StackPanel></Border>
    </Grid>
    <TextBlock Text="세밀 조정 · 정확한 값은 키보드로 입력" FontWeight="SemiBold"/>
    <ComboBox x:Name="PrecisionChoice" SelectedIndex="0" SelectionChanged="Precision_Changed" AutomationProperties.Name="조정할 값" MinHeight="40"><ComboBoxItem Content="음량 (%)"/><ComboBoxItem Content="확대·축소 (%)"/><ComboBoxItem Content="위치 (가로·세로 %)"/></ComboBox>
    <CheckBox x:Name="PinchEnabled" Content="핀치 조정 허용 · 기본 꺼짐 (Esc로 해제)" Checked="Precision_Changed" Unchecked="Precision_Changed" Margin="0,8"/>
    <WrapPanel>
     <StackPanel><TextBlock Text="음량 0–100 / 확대 50–200"/><TextBox x:Name="ExactValue" Text="50" Width="180" AutomationProperties.Name="정확한 조정 값"/></StackPanel>
     <StackPanel Margin="10,0"><TextBlock Text="가로 -100–100"/><TextBox x:Name="ExactX" Text="0" Width="110" AutomationProperties.Name="가로 위치"/></StackPanel>
     <StackPanel><TextBlock Text="세로 -100–100"/><TextBox x:Name="ExactY" Text="0" Width="110" AutomationProperties.Name="세로 위치"/></StackPanel>
    </WrapPanel>
    <WrapPanel><Button Content="키보드 값 적용" Click="ExactApply_Click"/><Button Content="화면 배치 초기화" Click="ResetView_Click"/></WrapPanel>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="카메라 미리보기" FontWeight="SemiBold"/>
    <ContentControl x:Name="CameraHost" Height="220"/>
    <TextBlock x:Name="RecentNotice" Text="사용할 기능을 켜면 상태를 여기에서 확인할 수 있어요." Foreground="#61736A" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</Window>
