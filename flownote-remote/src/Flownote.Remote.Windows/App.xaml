<Application x:Class="Flownote.Remote.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="NetworkWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#276254"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="BorderBrush" Value="#E5E7E2"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Switch" TargetType="ToggleButton">
   <Setter Property="Width" Value="56"/><Setter Property="Height" Value="44"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="FocusBorder" Padding="3" BorderThickness="2" BorderBrush="Transparent" CornerRadius="20">
     <Border x:Name="Track" Height="28" CornerRadius="14" Background="#CBD2CF"><Ellipse x:Name="Knob" Fill="White" Width="20" Height="20" Margin="4" HorizontalAlignment="Left"/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#276254"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="#3576CC"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
