<Application x:Class="Flownote.Remote.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,8,12,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="MinHeight" Value="32"/></Style>
 </Application.Resources>
</Application>
