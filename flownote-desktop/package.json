{
  "name": "flownote-desktop",
  "productName": "Flownote",
  "version": "1.2.0",
  "description": "Flownote Windows desktop application",
  "author": "Flownote",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:staging": "electron . --staging",
    "test": "node --test test/*.test.cjs",
    "check": "node --check main.cjs && node --check policy.cjs && node --check updater.cjs && npm test",
    "icons": "node scripts/create-icon.cjs",
    "package:win": "npm run check && npm run icons && electron-builder --win --x64 --publish never && node scripts/checksums.cjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "com.flownote.desktop",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["main.cjs", "policy.cjs", "updater.cjs", "update-public.pem", "package.json", "build/icon.png"],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico",
      "artifactName": "Flownote-Portable-${version}-${arch}.${ext}",
      "executableName": "Flownote"
    },
    "nsis": {
      "include": "installer.nsh",
      "artifactName": "Flownote-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
