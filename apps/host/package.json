{
  "name": "@flownote/remote-host",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated WSS-to-PTY host agent for the Flownote remote terminal MVP",
  "type": "module",
  "bin": {
    "remote-host": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
